---
// Tabbed, syntax-highlighted source files. Colors come from the site palette via shiki's css-variables theme.
import { Code } from 'astro:components';

interface Props {
  files: { name: string; label: string; code: string; summary?: string; tools?: string[] }[];
  id: string;
}

const { files, id } = Astro.props;
---

<div class="code-tabs" data-code-tabs>
  <div class="tablist" role="tablist">
    {
      files.map((f, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {f.label}
        </button>
      ))
    }
  </div>
  {
    files.map((f, i) => (
      <section role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} hidden={i !== 0}>
        {f.summary && <p class="summary">{f.summary}</p>}
        {f.tools && (
          <p class="tools">
            {f.tools.map((t) => (
              <span>{t}</span>
            ))}
          </p>
        )}
        <div class="file">
          <div class="file-head">
            <span>{f.name}</span>
            <span class="muted">{f.code.split('\n').length} lines · Python</span>
          </div>
          <div class="file-body">
            <Code code={f.code} lang="python" theme="css-variables" />
          </div>
        </div>
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-code-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (i: number) =>
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
        if (on) t.focus();
      });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length);
      });
    });
  });
</script>

<style>
  .code-tabs {
    margin: 1.5rem 0 2rem;
    --astro-code-foreground: var(--fg);
    --astro-code-background: transparent;
    --astro-code-token-comment: var(--muted);
    --astro-code-token-keyword: var(--accent);
    --astro-code-token-string: var(--earth);
    --astro-code-token-string-expression: var(--earth);
    --astro-code-token-constant: var(--accent-2);
    --astro-code-token-function: var(--accent-2);
    --astro-code-token-parameter: var(--fg);
    --astro-code-token-punctuation: var(--muted);
    --astro-code-token-link: var(--accent);
  }
  .tablist {
    display: flex;
    gap: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  [role='tab'] {
    font: inherit;
    font-variant: small-caps;
    letter-spacing: 0.04em;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.3rem 0;
    margin-bottom: -1px;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  [role='tab']:hover {
    color: var(--fg);
  }
  [role='tab'][aria-selected='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  [role='tabpanel'] {
    animation: fade 0.35s ease;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .summary {
    margin: 1rem 0 0.5rem;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
  }
  .tools span {
    font-family: var(--mono);
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule);
    color: var(--muted);
  }
  .file {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .file-head {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    font-family: var(--mono);
    font-size: 0.7rem;
  }
  .file-body {
    max-height: 30rem;
    overflow: auto;
    mask-image: linear-gradient(#000 calc(100% - 2rem), transparent);
  }
  .file-body :global(pre) {
    margin: 0;
    padding: 0.5rem 0 2rem;
    background: transparent !important;
    font-size: 0.72rem;
    line-height: 1.55;
  }
</style>
