<style>
  .resume {
    font-family: 'EB Garamond', Garamond, Georgia, serif;
    font-variant-numeric: lining-nums;
    line-height: 1.22;
  }
  .resume p {
    margin: 0;
    hyphens: manual;
  }
  .resume a {
    color: inherit;
  }
  header {
    text-align: center;
    margin-bottom: 0.6em;
  }
  .who {
    font-weight: 700;
    font-size: 1.2em;
  }
  .who a:first-of-type {
    color: #1155cc;
  }
  .tagline {
    margin-top: 0.1em !important;
  }
  h2 {
    font-size: 1.05em;
    font-weight: 700;
    font-variant: normal;
    letter-spacing: 0;
    text-transform: uppercase;
    margin: 0.9em 0 0.45em;
    padding-bottom: 0.1em;
    border-bottom: 1px solid currentColor;
  }
  .entry {
    margin-bottom: 0.75em;
  }
  .head,
  .role {
    display: flex;
    justify-content: space-between;
    gap: 1em;
  }
  .head span,
  .role span {
    flex: none;
  }
  .role {
    font-style: italic;
    margin-top: 0.15em !important;
  }
  ul {
    margin: 0.05em 0 0;
    padding-left: 1.35em;
    list-style: none;
  }
  li {
    position: relative;
  }
  li::before {
    content: '●';
    position: absolute;
    left: -1.1em;
    font-size: 0.8em;
    top: 0.08em;
  }
</style>
