---
import Contact from './Contact.astro';
import { site } from '../site';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap inner">
    <p class="cta">Get in touch</p>
    <Contact />
    <p class="small">© {year} {site.name} · Built with Astro, typeset in EB Garamond.</p>
  </div>
  <div class="stripe" aria-hidden="true"></div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    background: var(--ink);
    color: var(--on-ink);
    /* palette swatches in the footer link colours */
    --fg: var(--on-ink);
    --rule: color-mix(in srgb, var(--on-ink) 25%, transparent);
    --accent: #dcb0b9;
    --accent-2: #b4c5d9;
    --earth: #d3b8a4;
    --plum: #d0b3c3;
  }
  .inner {
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }
  .cta {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }
  .small {
    margin: 1.5rem 0 0;
    font-size: 0.8rem;
    opacity: 0.6;
  }
  .stripe {
    /* the wardrobe, as a stripe: burgundy, plum, indigo, washed denim, leather, sand */
    height: 4px;
    opacity: 0.75;
    background: linear-gradient(
      90deg,
      #8a4555 0 18%,
      #79546a 18% 34%,
      #4a5470 34% 52%,
      #b3c3d6 52% 70%,
      #8a6c57 70% 86%,
      #dcd3c2 86% 100%
    );
  }
</style>
