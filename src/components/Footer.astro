---
import Contact from './Contact.astro';
import { site } from '../site';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap inner">
    <p class="cta">Get in touch</p>
    <Contact />
    <p class="small">© {year} {site.name} · Built with Astro, typeset in EB Garamond.</p>
  </div>
  <div class="stripe" aria-hidden="true"></div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    background: var(--ink);
    color: var(--on-ink);
    /* palette swatches in the footer link colours */
    --fg: var(--on-ink);
    --rule: color-mix(in srgb, var(--on-ink) 25%, transparent);
    --accent: #d39aa6;
    --accent-2: #9fb6d2;
    --earth: #c9a58c;
    --plum: #c49ab1;
  }
  .inner {
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }
  .cta {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }
  .small {
    margin: 1.5rem 0 0;
    font-size: 0.8rem;
    opacity: 0.6;
  }
  .stripe {
    /* the wardrobe, as a stripe: burgundy, plum, indigo, washed denim, leather, sand */
    height: 6px;
    background: linear-gradient(
      90deg,
      #6e2a3a 0 18%,
      #563046 18% 34%,
      #2c3550 34% 52%,
      #8fa9c6 52% 70%,
      #7b5a45 70% 86%,
      #d8cdb8 86% 100%
    );
  }
</style>
