---
import { nav, site } from '../site';
import phi from './phi-path.txt?raw';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="topbar">
  <a href={`mailto:${site.email}`}>{site.email}</a>
  <span class="links">
    <a href="/cv.pdf">CV (PDF)</a>
    <a href={site.github}>GitHub</a>
    <a href={site.linkedin}>LinkedIn</a>
    <a href="/resources/putnam/">Putnam bank</a>
    <a href="/admin/">Admin</a>
  </span>
</div>

<header>
  <a class="name" href="/"><span class="mark" aria-hidden="true"><svg viewBox="0 0 64 64"><path d={phi} /></svg></span>{site.name}</a>
  <nav aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    padding-top: 0.6rem;
    font-size: 0.8rem;
  }
  .topbar .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
  }
  .topbar a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .topbar a:hover {
    color: var(--accent-hover);
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 2rem 0 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    margin-right: 0.55rem;
    border-radius: 5px;
    background: var(--accent);
    vertical-align: -0.3em;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .mark svg {
    width: 100%;
    height: 100%;
    fill: var(--bg);
  }
  .name:hover .mark {
    transform: rotate(-8deg) scale(1.06);
  }
  .name {
    color: var(--fg);
    text-decoration: none;
    font-size: 1.2rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.1rem;
  }
  @media (max-width: 34rem) {
    header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding-top: 1.25rem;
    }
    nav {
      gap: 0.2rem 0.85rem;
      font-size: 0.95rem;
    }
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-variant: small-caps;
    letter-spacing: 0.05em;
  }
  nav {
    align-items: baseline;
  }
  button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover {
    color: var(--accent);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }
</style>
