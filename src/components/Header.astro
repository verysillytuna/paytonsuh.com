---
import { nav, site } from '../site';
import phi from './phi-path.txt?raw';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="topbar">
  <span class="la">
    <span class="city">Los Angeles</span>
    <span id="la-clock"></span>
    <span id="la-weather"></span>
  </span>
  <span class="links">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href="/admin/">Admin</a>
  </span>
</div>

<header>
  <a class="name" href="/"><span class="mark" aria-hidden="true"><svg viewBox="0 0 64 64"><path d={phi} /></svg></span>{site.name}</a>
  <nav aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
  </nav>
</header>

<script>
  // Los Angeles time (updates each minute) and current weather from Open-Meteo (free, no key).
  const clock = document.getElementById('la-clock')!;
  const fmt = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Los_Angeles',
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
  const tick = () => {
    const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((p) => [p.type, p.value]));
    clock.textContent = `${parts.weekday}, ${parts.month} ${parts.day} · ${parts.hour}:${parts.minute} ${parts.dayPeriod}`;
  };
  tick();
  setTimeout(() => (tick(), setInterval(tick, 60_000)), 60_000 - (Date.now() % 60_000));

  const sky = (code: number) =>
    code === 0 ? 'Clear'
    : code <= 2 ? 'Partly cloudy'
    : code === 3 ? 'Cloudy'
    : code <= 48 ? 'Fog'
    : code <= 57 ? 'Drizzle'
    : code <= 67 ? 'Rain'
    : code <= 77 ? 'Snow'
    : code <= 82 ? 'Showers'
    : 'Thunderstorms';
  fetch('https://api.open-meteo.com/v1/forecast?latitude=34.05&longitude=-118.24&current=temperature_2m,weather_code&temperature_unit=fahrenheit')
    .then((r) => r.json())
    .then(({ current }) => {
      document.getElementById('la-weather')!.textContent =
        `${Math.round(current.temperature_2m)}°F, ${sky(current.weather_code)}`;
    })
    .catch(() => {});

  const btn = document.getElementById('theme-toggle')!;
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.2rem 1rem;
    padding: 0.55rem 0 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .la,
  .topbar .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
  }
  .la > span:not(:empty) + span:not(:empty)::before {
    content: '·';
    margin-right: 0.45rem;
    margin-left: -0.45rem;
    opacity: 0.6;
  }
  .city {
    font-variant: small-caps;
    letter-spacing: 0.05em;
  }
  .topbar a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .topbar a:hover {
    color: var(--accent-hover);
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 2rem 0 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    margin-right: 0.55rem;
    border-radius: 5px;
    background: var(--accent);
    vertical-align: -0.3em;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .mark svg {
    width: 100%;
    height: 100%;
    fill: var(--bg);
  }
  .name:hover .mark {
    transform: rotate(-8deg) scale(1.06);
  }
  .name {
    color: var(--fg);
    text-decoration: none;
    font-size: 1.2rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.1rem;
  }
  @media (max-width: 34rem) {
    header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding-top: 1.25rem;
    }
    nav {
      gap: 0.2rem 0.85rem;
      font-size: 0.95rem;
    }
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-variant: small-caps;
    letter-spacing: 0.05em;
  }
  nav {
    align-items: baseline;
  }
  button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover {
    color: var(--accent);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }
</style>
