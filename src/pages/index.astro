---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../site';
import MathFigure from '../components/MathFigure.astro';
import portrait from '../assets/portrait.jpg';

const recent = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="intro">
    <canvas class="hero-flow" data-math-figure="flow" aria-hidden="true"></canvas>
    <div>
      <h1>{site.name}</h1>
      <p class="muted">Mathematics · UCLA</p>
    </div>
    <figure class="portrait">
      <Image src={portrait} alt={`Portrait of ${site.name}`} width={180} densities={[1, 2]} loading="eager" />
    </figure>
  </section>

  <p>
    I am an 18-year-old third-year mathematics student at UCLA. I began college
    at sixteen at Santa Monica College before transferring to UCLA, and I plan
    to apply to the Departmental Scholars Program for a combined B.S./M.A. I
    intend to pursue a PhD in mathematics.
  </p>
  <p>
    I am highly invested in the intersection of mathematics, the physical
    sciences, and computer science. Within mathematics, I enjoy pure
    mathematics, especially <em>analysis</em>, <em>algebra</em>, and
    <em>topology</em>, along with <em>probability</em>, which sits between the
    pure and the applied.
  </p>
  <p>
    I enjoy open-ended problems that require abstract thinking, and I train my
    problem solving through puzzles, competition mathematics, and algorithmic
    coding challenges.
  </p>

  <p>
    Outside of coursework, I am a co-investigator on ZrC-ARC, a NASA
    L’SPACE–funded project on refractory coatings for hypersonic and nuclear
    thermal propulsion. I was its principal investigator from January to
    October 2026 and now lead its research and LAMMPS simulation work, and I tutor physics and chemistry. Until June 2026 I
    analyzed stellar light curves for variable stars. See
    <a href="/research/">Research</a>.
  </p>
  <p>
    I am into photography, mostly streets, stations, and temples, and drawn to
    lines that converge and forms that repeat; some of it is
    <a href="/photography/">here</a>. Away from the desk I also boulder (up to
    V7), play pool (8-ball and 9-ball), and cook.
  </p>

  <MathFigure
    kind="lorenz"
    caption="The Lorenz attractor: two trajectories starting 10<sup>−5</sup> apart, burgundy and blue, eventually part ways."
    height={200}
  />

  <h2>Things I think about</h2>
  <div class="figures">
    <MathFigure kind="mobius" caption="<b>Möbius strip.</b> Carry a normal vector once around and it returns pointing the other way: the surface is non-orientable." height={170} />
    <MathFigure kind="hopf" caption="<b>Hopf fibration.</b> <i>S</i><sup>3</sup> as a bundle of circles over <i>S</i><sup>2</sup>; any two fibres are linked." height={170} />
    <MathFigure kind="gbm" caption="<b>Geometric Brownian motion.</b> d<i>S</i> = μ<i>S</i> d<i>t</i> + σ<i>S</i> d<i>W</i>; terminal prices pile up into a lognormal law." height={170} />
    <MathFigure kind="qv" caption="<b>Quadratic variation.</b> Σ(Δ<i>W</i>)² over finer partitions converges to <i>t</i>: the reason Itô’s formula has a second-order term." height={170} />
  </div>

  <h2>Currently</h2>
  <ul>
    <li>Math 110AH: Algebra (Honors)</li>
    <li>Math 115AH: Linear Algebra (Honors)</li>
    <li>Math 131AH: Analysis (Honors)</li>
  </ul>
  <p class="muted">
    Planned: abstract algebra, analysis, complex analysis, geometric analysis,
    topology, probability theory, and stochastic calculus.
  </p>
  <p>Preparing for the William Lowell Putnam Mathematical Competition.</p>

  <h3>Reading</h3>
  <ul>
    <li>Walter Rudin, <cite>Principles of Mathematical Analysis</cite></li>
    <li>
      Friedberg, Insel &amp; Spence, <cite>Linear Algebra</cite>, 5th ed.
    </li>
    <li>
      Richard Elman,
      <a href="https://www.math.ucla.edu/~rse/algebra_book.pdf"><cite>Lectures on Abstract Algebra</cite></a>
    </li>
  </ul>

  {
    recent.length > 0 && (
      <>
        <h2>Recent notes</h2>
        <ul class="notes">
          {recent.map((n) => (
            <li>
              <a href={`/notes/${n.id}/`}>{n.data.title}</a>
              <span class="muted">
                {' '}
                · {n.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .hero-flow {
    /* full-bleed phase portrait behind the name */
    position: absolute;
    z-index: -1;
    top: -1.5rem;
    bottom: -1.5rem;
    left: 50%;
    width: min(64rem, 100vw);
    height: calc(100% + 3rem);
    transform: translateX(-50%);
    opacity: 0.55;
    mask-image: radial-gradient(ellipse at center, #000 45%, transparent 80%);
    pointer-events: none;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0 1.5rem;
  }
  .figures :global(figcaption) {
    text-align: left;
  }
  .portrait {
    flex: none;
    margin: 0;
    padding: 5px;
    border: 1px solid var(--rule);
    background: var(--bg);
  }
  .portrait img {
    display: block;
    width: 180px;
    height: auto;
  }
  @media (max-width: 30rem) {
    .intro {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }
    .portrait img {
      width: 160px;
    }
  }
  ul {
    padding-left: 1.2rem;
  }
  li {
    margin-bottom: 0.25rem;
  }
</style>
