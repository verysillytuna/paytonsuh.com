---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';

const recent = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="intro">
    <h1>{site.name}</h1>
    <p class="muted">Undergraduate in Mathematics · {site.affiliation}</p>
  </section>

  <p>
    I am an 18-year-old third-year mathematics student at UCLA. I began college
    at sixteen at Santa Monica College before transferring to UCLA, where I am
    working toward a combined B.S./M.A. through the Departmental Scholars
    Program. I intend to pursue a PhD in mathematics.
  </p>
  <p>
    I am highly invested in the intersection of mathematics, the physical
    sciences, and computer science. Within mathematics, I enjoy pure
    mathematics, especially <em>analysis</em>, <em>algebra</em>, and
    <em>topology</em>, along with <em>probability</em>, which sits between the
    pure and the applied.
  </p>
  <p>
    I enjoy open-ended problems that require abstract thinking, and I train my
    problem solving through puzzles, competition mathematics, and algorithmic
    coding challenges.
  </p>

  <p>
    Outside of coursework, I lead a materials-science project on refractory
    coatings for nuclear thermal propulsion, analyze stellar light curves for
    variable stars, and tutor physics and chemistry. See
    <a href="/research/">Research</a>. Away from the desk I play violin and
    hold a third-degree black belt in taekwondo.
  </p>

  <h2>Currently</h2>
  <ul>
    <li>Math 110AH: Algebra (Honors)</li>
    <li>Math 115AH: Linear Algebra (Honors)</li>
    <li>Math 131AH: Analysis (Honors)</li>
  </ul>
  <p class="muted">
    Planned beyond the major: topology, probability theory, and stochastic
    calculus.
  </p>
  <p>Preparing for the William Lowell Putnam Mathematical Competition.</p>

  <h3>Reading</h3>
  <ul>
    <li>Walter Rudin, <cite>Principles of Mathematical Analysis</cite></li>
    <li>
      Friedberg, Insel &amp; Spence, <cite>Linear Algebra</cite>, 5th ed.
    </li>
    <li>
      Richard Elman,
      <a href="https://www.math.ucla.edu/~rse/algebra_book.pdf"><cite>Lectures on Abstract Algebra</cite></a>
    </li>
  </ul>

  {
    recent.length > 0 && (
      <>
        <h2>Recent notes</h2>
        <ul class="notes">
          {recent.map((n) => (
            <li>
              <a href={`/notes/${n.id}/`}>{n.data.title}</a>
              <span class="muted">
                {' '}
                · {n.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  .intro {
    margin-bottom: 1.5rem;
  }
  ul {
    padding-left: 1.2rem;
  }
  li {
    margin-bottom: 0.25rem;
  }
</style>
