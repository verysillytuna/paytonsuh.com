---
import Base from '../../layouts/Base.astro';
import Resume from '../../components/Resume.astro';
import MathFigure from '../../components/MathFigure.astro';
import PdfPaper from '../../components/PdfPaper.astro';
---

<Base title="CV" description="Curriculum vitae of Payton Suh.">
  <MathFigure
    kind="conformal"
    caption="A square grid under the Möbius map <i>z</i> ↦ (<i>z</i> − <i>a</i>)/(1 − <i>āz</i>): lines become circles, and right angles survive."
    height={190}
  />

  <div class="head">
    <h1>Curriculum Vitae</h1>
    <a href="/cv.pdf" download="Payton-Suh-CV.pdf">Download PDF</a>
  </div>

  <PdfPaper src="/cv.pdf" label="CV">
    <noscript slot="fallback"><Resume /></noscript>
  </PdfPaper>

  <details class="text">
    <summary>Read as plain text</summary>
    <Resume />
  </details>
</Base>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .head a {
    font-variant: small-caps;
    letter-spacing: 0.05em;
  }
  .text summary {
    cursor: pointer;
    color: var(--accent);
  }
  .text[open] summary {
    margin-bottom: 1rem;
  }
</style>
