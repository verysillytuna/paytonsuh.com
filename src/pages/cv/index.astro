---
import Base from '../../layouts/Base.astro';
import CvBody from '../../components/CvBody.astro';
import MathFigure from '../../components/MathFigure.astro';
---

<Base title="CV" description="Curriculum vitae of Payton Suh.">
  <MathFigure
    kind="conformal"
    caption="A square grid under the Möbius map <i>z</i> ↦ (<i>z</i> − <i>a</i>)/(1 − <i>āz</i>): lines become circles, and right angles survive."
    height={190}
  />
  <CvBody>
    <p slot="actions" class="actions">
      <a href="/cv.pdf" download="Payton-Suh-CV.pdf">Download PDF</a>
    </p>
  </CvBody>
</Base>

<style>
  .actions {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }
</style>
