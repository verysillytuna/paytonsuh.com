---
// Print source for public/cv.pdf. Not linked from the site; regenerate with `npm run cv:pdf`.
import CvBody from '../../components/CvBody.astro';
import '../../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Payton Suh — CV</title>
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <CvBody />
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: letter;
    margin: 0.45in 0.6in;
  }
  html {
    font-size: 10pt;
  }
  body {
    background: #fff;
    color: #1d1d1b;
    line-height: 1.3;
  }
  main {
    max-width: none;
  }
  .cv h1 {
    font-size: 19pt;
  }
  .cv h2 {
    font-size: 12.5pt;
    margin: 0.6rem 0 0.1rem;
    padding-bottom: 0.15rem;
    border-bottom: 0.5pt solid #bbb;
  }
  .cv dt {
    margin-top: 0.3rem;
  }
  .cv h2 {
    break-after: avoid;
  }
  .cv dt {
    break-after: avoid;
  }
  .cv p {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
</style>
