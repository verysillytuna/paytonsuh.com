---
import Base from '../../layouts/Base.astro';
import MathFigure from '../../components/MathFigure.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Notes" description="Mathematical notes and expository writing.">
  <h1>Notes</h1>
  <p class="muted">Expository notes, problem write-ups, and things I am learning.</p>

  <MathFigure kind="fourier" caption="A square wave from its first seven odd Fourier terms, Σ 4 sin(<i>nt</i>)/<i>nπ</i>." />

  <a class="featured" href="/notes/linear-algebra/">
    <span class="tag">Reference · PDF</span>
    <span class="ftitle">Linear Algebra: A Reference</span>
    <span class="fdesc">Notation, definitions, and theorems from vector spaces to the singular value decomposition, typeset in LaTeX.</span>
  </a>

  <a class="featured" href="/notes/fall-2026/">
    <span class="tag">Class notes · PDF</span>
    <span class="ftitle">Class Notes, Fall 2026</span>
    <span class="fdesc">Weekly lecture notes from honors analysis (131AH), algebra (110AH), and linear algebra (115AH), typeset in LaTeX.</span>
  </a>

  <ul>
    {
      notes.map((n) => (
        <li>
          <a href={`/notes/${n.id}/`}>{n.data.title}</a>
          <span class="muted">
            {' '}
            · {n.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </span>
          <p class="summary">{n.data.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    margin: 1.25rem 0;
  }
  .featured {
    display: grid;
    gap: 0.2rem;
    margin: 1.5rem 0;
    padding: 1rem 1.1rem;
    background: var(--tint-denim);
    border-left: 2px solid color-mix(in srgb, var(--accent-2) 60%, transparent);
    color: var(--fg);
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .featured:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -18px rgb(30 34 48 / 0.5);
  }
  .tag {
    font-size: 0.75rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--accent-2);
  }
  .ftitle {
    font-size: 1.25rem;
    color: var(--accent);
  }
  .fdesc {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .summary {
    margin: 0.15rem 0 0;
  }
</style>
