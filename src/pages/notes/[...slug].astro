---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.summary}>
  <article>
    <h1>{note.data.title}</h1>
    <p class="muted">
      {note.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      {note.data.tags.length > 0 && <> · {note.data.tags.join(', ')}</>}
    </p>
    <Content />
  </article>
  <p><a href="/notes/">← All notes</a></p>
</Base>
