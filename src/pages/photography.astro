---
import Base from '../layouts/Base.astro';
import MathFigure from '../components/MathFigure.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../data/photos';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const items = photos.map((p) => {
  const mod = files[`../assets/photos/${p.file}.jpg`];
  if (!mod) throw new Error(`Missing photo: ${p.file}.jpg`);
  return { ...p, src: mod.default };
});
---

<Base title="Photography" description="Photographs by Payton Suh: perspective and repetition.">
  <h1>Photography</h1>
  <p class="muted">
    Lines that converge and forms that repeat: streets, rails, and paths running
    to a vanishing point, and rows of stones, lanterns, and daruma.
  </p>

  <MathFigure kind="perspective" caption="Parallel lines meet at a point at infinity: the projective plane, on the ground." height={130} />

  <div class="collage">
    {
      items.map((p, i) => (
        <figure style={`--r:${(p.src.width / p.src.height).toFixed(4)}`}>
          <a href={p.src.src} data-index={i} aria-label={`Open: ${p.caption}`}>
            <Image
              src={p.src}
              alt={p.caption}
              widths={[480, 960, 1440]}
              sizes="(max-width: 40rem) 100vw, 480px"
              loading={i < 6 ? 'eager' : 'lazy'}
            />
            <figcaption>{p.caption}</figcaption>
          </a>
        </figure>
      ))
    }
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button type="button" class="lb-close" aria-label="Close">×</button>
    <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="lb-next" aria-label="Next photo">›</button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const cap = dialog.querySelector('figcaption')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.collage a')];
  let current = 0;

  function show(i: number) {
    current = (i + links.length) % links.length;
    const link = links[current];
    const thumb = link.querySelector('img')!;
    img.classList.remove('in');
    img.src = link.href;
    img.alt = thumb.alt;
    cap.textContent = thumb.alt;
    img.decode().catch(() => {}).finally(() => img.classList.add('in'));
  }
  links.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
</script>

<style>
  .collage {
    /* Justified rows: each photo grows in proportion to its aspect ratio --r, so every row shares one height. */
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    --w: min(68rem, calc(100vw - 2rem));
    width: var(--w);
    margin: 2rem 0 0 calc((100% - var(--w)) / 2);
  }
  .collage::after {
    /* keeps the last row from stretching */
    content: '';
    flex-grow: 999;
  }
  figure {
    flex: var(--r) 1 calc(var(--r) * 13rem);
    margin: 0;
    overflow: hidden;
    position: relative;
  }
  figure a {
    display: block;
    height: 100%;
  }
  figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.4s;
  }
  figure figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 0.6rem 0.45rem;
    font-size: 0.8rem;
    font-style: italic;
    color: #f6f4ef;
    background: linear-gradient(transparent, rgb(22 25 32 / 0.75));
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  figure:hover img,
  figure a:focus-visible img {
    transform: scale(1.035);
  }
  figure:hover figcaption,
  figure a:focus-visible figcaption {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    figure figcaption {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 30rem) {
    figure {
      flex-basis: calc(var(--r) * 9rem);
    }
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(22 25 32 / 0.94);
    color: #e8e5de;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: 3.5rem 1fr 3.5rem;
    align-items: center;
    animation: lb-in 0.3s ease;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox figure {
    margin: 0;
    overflow: visible;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 2.5rem 0;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .lightbox img.in {
    opacity: 1;
    transform: none;
  }
  .lightbox figcaption {
    position: static;
    margin-top: 0.75rem;
    padding: 0;
    background: none;
    opacity: 1;
    transform: none;
    font-size: 0.95rem;
  }
  .lightbox button {
    font: inherit;
    font-size: 2rem;
    line-height: 1;
    color: #e8e5de;
    background: none;
    border: 0;
    cursor: pointer;
    opacity: 0.7;
    height: 100%;
  }
  .lightbox button:hover {
    opacity: 1;
  }
  .lb-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    height: auto !important;
  }
</style>
