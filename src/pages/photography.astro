---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../data/photos';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const items = photos.map((p) => {
  const mod = files[`../assets/photos/${p.file}.jpg`];
  if (!mod) throw new Error(`Missing photo: ${p.file}.jpg`);
  return { ...p, src: mod.default };
});
---

<Base title="Photography" description="Photographs by Payton Suh: perspective and repetition.">
  <h1>Photography</h1>
  <p class="muted">
    Lines that converge and forms that repeat: streets, rails, and paths running
    to a vanishing point, and rows of stones, lanterns, and daruma.
  </p>

  <div class="collage">
    {
      items.map((p, i) => (
        <figure>
          <a href={p.src.src} aria-label={`Open full size: ${p.caption}`}>
            <Image
              src={p.src}
              alt={p.caption}
              widths={[400, 800, 1200]}
              sizes="(max-width: 40rem) 100vw, 380px"
              loading={i < 4 ? 'eager' : 'lazy'}
            />
          </a>
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</Base>

<style>
  .collage {
    /* Masonry via CSS columns; the collage breaks out of the text column on wide screens. */
    columns: 2;
    column-gap: 1rem;
    width: min(64rem, calc(100vw - 2rem));
    margin: 2rem 0 0 50%;
    transform: translateX(-50%);
  }
  @media (min-width: 52rem) {
    .collage {
      columns: 3;
    }
  }
  @media (max-width: 30rem) {
    .collage {
      columns: 1;
    }
  }
  figure {
    break-inside: avoid;
    margin: 0 0 1.25rem;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    padding: 4px;
    background: var(--bg);
  }
  figcaption {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
  }
</style>
