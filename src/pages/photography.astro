---
import Base from '../layouts/Base.astro';
import MathFigure from '../components/MathFigure.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos } from '../data/photos';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const items = photos.map((p) => {
  const mod = files[`../assets/photos/${p.file}.jpg`];
  if (!mod) throw new Error(`Missing photo: ${p.file}.jpg`);
  return { ...p, src: mod.default };
});

// Column spans on a 12-column grid, cycled so neighbouring photos differ in size.
// Portraits get narrower spans; some photos drop down a little to break the baseline.
const pattern = [7, 5, 4, 4, 4, 5, 7, 6, 6, 4, 8, 3, 5, 4];
const layout = items.map((p, i) => {
  const ratio = p.src.width / p.src.height;
  let c = pattern[i % pattern.length];
  if (ratio < 1) c = Math.max(3, Math.min(5, c - 2));
  return { c, cm: c >= 6 ? 2 : 1, drop: i % 5 === 2 || i % 7 === 4, align: i % 3 === 1 ? 'end' : 'start' };
});
---

<Base title="Photography" description="Photographs by Payton Suh: perspective and repetition.">
  <h1>Photography</h1>
  <p class="muted">
    Lines that converge and forms that repeat, and the places in between:
    Toronto, Kyoto, Osaka, Kawaguchiko, San Francisco, New York, and home in
    Los Angeles.
  </p>

  <MathFigure kind="golden" caption="The golden rectangle: cut off a square and what remains is golden again. The spiral through the squares is the photographer’s composition guide, and the reason for the φ." height={170} />

  <div class="collage" data-collage>
    {
      items.map((p, i) => (
        <figure
          class:list={{ drop: layout[i].drop }}
          style={`--c:${layout[i].c};--cm:${layout[i].cm};--ar:${(p.src.width / p.src.height).toFixed(4)}`}
          data-align={layout[i].align}
        >
          <a href={p.src.src} data-index={i} aria-label={`Open: ${p.caption}`}>
            <Image
              src={p.src}
              alt={p.caption}
              widths={[480, 960, 1440]}
              sizes={`(max-width: 40rem) 100vw, ${Math.round((layout[i].c / 12) * 1100)}px`}
              loading={i < 6 ? 'eager' : 'lazy'}
            />
          </a>
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button type="button" class="lb-close" aria-label="Close">×</button>
    <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="lb-next" aria-label="Next photo">›</button>
  </dialog>
</Base>

<script>
  // Masonry on a CSS grid: each figure spans as many 4px rows as its rendered height needs.
  const grid = document.querySelector<HTMLElement>('[data-collage]')!;
  const figures = [...grid.querySelectorAll<HTMLElement>('figure')];
  function layoutRows() {
    if (getComputedStyle(grid).gridAutoRows === 'auto') return;
    for (const f of figures) {
      f.style.gridRowEnd = 'auto';
      const h = f.getBoundingClientRect().height;
      f.style.gridRowEnd = `span ${Math.ceil((h + 20) / 4)}`;
    }
  }
  new ResizeObserver(layoutRows).observe(grid);
  grid.querySelectorAll('img').forEach((img) => img.addEventListener('load', layoutRows));
  layoutRows();
</script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const cap = dialog.querySelector('figcaption')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.collage a')];
  let current = 0;

  function show(i: number) {
    current = (i + links.length) % links.length;
    const link = links[current];
    const thumb = link.querySelector('img')!;
    img.classList.remove('in');
    img.src = link.href;
    img.alt = thumb.alt;
    cap.textContent = thumb.alt;
    img.decode().catch(() => {}).finally(() => img.classList.add('in'));
  }
  links.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
</script>

<style>
  .collage {
    --w: min(70rem, calc(100vw - 2rem));
    width: var(--w);
    margin: 2.5rem 0 0 calc((100% - var(--w)) / 2);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: row dense;
    column-gap: 1.25rem;
    align-items: start;
  }
  :global(.js) .collage {
    grid-auto-rows: 4px;
  }
  .collage figure {
    grid-column: span var(--c);
    margin: 0;
    break-inside: avoid;
  }
  .collage figure.drop {
    padding-top: 2.75rem;
  }
  .collage figure[data-align='end'] figcaption {
    justify-content: flex-end;
    text-align: right;
  }
  figure a {
    /* small passe-partout frame */
    display: block;
    overflow: hidden;
    padding: 5px;
    border: 1px solid var(--rule);
    background: var(--bg);
    transition:
      border-color 0.3s,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.5s;
  }
  figure a:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px rgb(30 34 48 / 0.45);
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    object-fit: cover;
    filter: saturate(0.92);
    transition: filter 0.5s;
  }
  figure a:hover img {
    filter: saturate(1.05);
  }
  .collage figcaption {
    display: flex;
    margin-top: 0.45rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.75rem;
    }
    .collage figure {
      grid-column: span var(--cm);
    }
    .collage figure.drop {
      padding-top: 1.25rem;
    }
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(22 25 32 / 0.94);
    color: #e8e5de;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: 3.5rem 1fr 3.5rem;
    align-items: center;
    animation: lb-in 0.3s ease;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox figure {
    margin: 0;
    overflow: visible;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 2.5rem 0;
  }
  .lightbox img {
    padding: 0;
    max-width: 100%;
    max-height: calc(100vh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .lightbox img.in {
    opacity: 1;
    transform: none;
  }
  .lightbox figcaption {
    display: block;
    color: #e8e5de;
    position: static;
    margin-top: 0.75rem;
    padding: 0;
    background: none;
    opacity: 1;
    transform: none;
    font-size: 0.95rem;
  }
  .lightbox button {
    font: inherit;
    font-size: 2rem;
    line-height: 1;
    color: #e8e5de;
    background: none;
    border: 0;
    cursor: pointer;
    opacity: 0.7;
    height: 100%;
  }
  .lightbox button:hover {
    opacity: 1;
  }
  .lb-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    height: auto !important;
  }
</style>
