---
import Base from '../../layouts/Base.astro';
import MathFigure from '../../components/MathFigure.astro';
import { projects } from '../../data/projects';
import { recommendation } from '../../data/recommendation';

const order = { ongoing: 0, planned: 1, completed: 2 } as const;
const sorted = [...projects].sort((a, b) => order[a.status] - order[b.status]);
---

<Base title="Research" description="Research, projects, and directed reading.">
  <h1>Research &amp; Projects</h1>
  <p class="muted">
    Mathematics, computer science, and the physical sciences — ongoing work,
    directed reading, and completed projects.
  </p>

  <MathFigure kind="brownian" caption="Sample paths of Brownian motion inside the envelope ±2√<i>t</i>." />

  {
    sorted.map((p) => (
      <article>
        <h3>{p.page ? <a href={p.page}>{p.title}</a> : p.title}</h3>
        <p class="meta muted">
          <span class="smallcaps">{p.area}</span> · {p.period} · {p.status}
        </p>
        <p>{p.description}</p>
        {p.roles && (
          <ol class="roles">
            {p.roles.map((r) => (
              <li>
                <p class="role">
                  <strong>{r.title}</strong> <span class="muted">· {r.period}</span>
                </p>
                <p>{r.description}</p>
              </li>
            ))}
          </ol>
        )}
        {p.page && (
          <p class="links">
            <a href={p.page}>Read the project overview →</a>
          </p>
        )}
        {p.links && (
          <p class="links">
            {p.links.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={l.href}>{l.label}</a>
              </>
            ))}
          </p>
        )}
      </article>
    ))
  }

  <h2>From a recommendation</h2>
  <figure class="rec">
    {recommendation.quotes.map((q) => <blockquote>“{q}”</blockquote>)}
    <figcaption>
      {recommendation.author}, {recommendation.role}<br />
      <span class="muted">{recommendation.context}</span>
    </figcaption>
  </figure>
</Base>

<style>
  article {
    margin: 1.75rem 0;
  }
  article h3 {
    margin-bottom: 0.15rem;
  }
  .roles {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0 0 0 1rem;
    border-left: 1px solid var(--rule);
  }
  .roles li {
    position: relative;
    margin-bottom: 0.75rem;
  }
  .roles li::before {
    /* timeline node */
    content: '';
    position: absolute;
    left: calc(-1rem - 4px);
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent);
  }
  .roles li:first-child::before {
    background: var(--accent);
  }
  .roles p {
    margin: 0 0 0.2rem;
  }
  .rec {
    margin: 0;
  }
  .rec blockquote {
    margin: 0 0 0.75rem;
    font-style: italic;
    color: var(--fg);
    border-left-color: var(--accent);
  }
  .rec figcaption {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .meta {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
</style>
