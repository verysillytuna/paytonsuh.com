---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('digest', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <p class="kicker"><a href="/digest/">Digest</a></p>
    <h1>{entry.data.title}</h1>
    <p class="muted">
      {entry.data.date.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      {entry.data.tags.length > 0 && <> · {entry.data.tags.join(', ')}</>}
    </p>
    <Content />
  </article>
  <nav class="pager" aria-label="Digest entries">
    {prev ? <a href={`/digest/${prev.id}/`}>← {prev.data.title}</a> : <span />}
    {next && <a href={`/digest/${next.id}/`}>{next.data.title} →</a>}
  </nav>
</Base>

<style>
  .kicker {
    margin: 0;
    font-size: 0.78rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    font-size: 0.92rem;
  }
</style>
